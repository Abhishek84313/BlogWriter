<div class="prompt-field">
    <label for="@Id">@Label</label>
    <textarea id="@Id"
              @ref="_input"
              value="@Value"
              @oninput="HandleInput"
              @onkeydown="HandleKeyDown"
              disabled="@Disabled"
              rows="2"
              aria-describedby="@DescriptionId"></textarea>
    <span id="@DescriptionId" class="sr-only">Press Enter to submit. Press Shift plus Enter for a new line.</span>
</div>

@code {
    private ElementReference _input;

    [Parameter, EditorRequired]
    public string Id { get; set; } = "";

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string Value { get; set; } = "";

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public EventCallback Submit { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private string DescriptionId => $"{Id}-description";

    public ValueTask FocusAsync() => _input.FocusAsync();

    private Task HandleInput(ChangeEventArgs args) =>
        ValueChanged.InvokeAsync(args.Value?.ToString() ?? "");

    private Task HandleKeyDown(KeyboardEventArgs args) =>
        args.Key == "Enter" && !args.ShiftKey && !string.IsNullOrWhiteSpace(Value)
            ? Submit.InvokeAsync()
            : Task.CompletedTask;
}
