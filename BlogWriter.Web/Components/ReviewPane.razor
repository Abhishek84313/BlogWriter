<section class="work-pane review-pane" aria-labelledby="review-heading">
    <header class="pane-heading">
        <span class="pane-index">02</span>
        <h2 id="review-heading">Reviewer notes</h2>
    </header>
    <div class="pane-content" tabindex="0" aria-live="polite" aria-atomic="false">
        @if (string.IsNullOrWhiteSpace(Content))
        {
            <p class="empty-copy">Reviewer feedback will appear here.</p>
        }
        else
        {
            <article class="review-copy">@Content</article>
        }
    </div>
</section>

@code {
    [Parameter]
    public string Content { get; set; } = "";
}
